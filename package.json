  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:cloud": "dotenv -e .env.cloud -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:migrate": "npx supabase db push",
