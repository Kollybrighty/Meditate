# ============================================================
# Meditate — Environment Template
# Copy to .env.local (local) or set in Vercel (cloud)
# ============================================================

# App URL
# Local:   http://localhost:3000
# Vercel:  https://your-app.vercel.app
# Domain:  https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on the privacy policy and terms. Required before a public launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase — get from `supabase start` (local) or Supabase dashboard (cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNmc3FuamtzZGRyaWxidnBubnZqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUzMjU3NzksImV4cCI6MjEwMDkwMTc3OX0.KstoKTCKLTzwpgBLEWdAu2ijQtP4xga8gznOtiSkX00
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNmc3FuamtzZGRyaWxidnBubnZqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTMyNTc3OSwiZXhwIjoyMTAwOTAxNzc5fQ.XHJ8OrDa4sEhXsSFCJyRGCPwTNVmlC5o-WLXXmh0mRw


# API.Bible Starter key — in-app NLT. Leave empty to open NLT on Bible Gateway.
# Create an app at https://scripture.api.bible and add NLT as one of the 3 copyrighted Bibles.
BIBLE_API_KEY=
# Optional if your dashboard shows a different NLT Bible ID
# API_BIBLE_NLT_ID=065c64f65a13ca21-01

# Email — https://resend.com/
# When set, password reset and group/Kids notices are sent through Resend.
# When empty, password reset still uses Supabase Auth email.
RESEND_API_KEY=
# Use onboarding@resend.dev until your domain is verified in Resend.
# After verification: Meditate <hello@your-domain.com>
RESEND_FROM_EMAIL=Meditate <onboarding@resend.dev>
# Optional. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
# ERROR_ALERT_EMAIL=
